{
  "name": "react-native-nitro-passkeys",
  "version": "0.0.0-development",
  "description": "WebAuthn passkeys for bare React Native, built with Nitro Modules",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "test": "bun test src",
    "clean": "git clean -dfX",
    "prepare": "lefthook install || true",
    "release": "semantic-release",
    "build": "bun run typecheck && bob build",
    "codegen": "nitrogen --logLevel=\"debug\" && bun run build"
  },
  "keywords": [
    "react-native",
    "nitro",
    "passkeys",
    "webauthn",
    "fido2",
    "react-native-nitro-passkeys"
  ],
  "files": [
    "src",
    "!src/**/__tests__",
    "lib",
    "nitrogen",
    "nitro.json",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "*.podspec",
    "README.md"
  ],
  "workspaces": [
    "example"
  ],
  "repository": "https://github.com/aparedes/react-native-nitro-passkeys.git",
  "author": "aparedes",
  "license": "MIT",
  "bugs": "https://github.com/aparedes/react-native-nitro-passkeys/issues",
  "homepage": "https://github.com/aparedes/react-native-nitro-passkeys#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.37.1 <0.38.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@simplewebauthn/server": "^14.0.2",
    "@types/bun": "^1.4.0",
    "@types/react": "19.2.18",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "lefthook": "^2.1.10",
    "nitrogen": "0.37.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.0",
    "react-native-nitro-modules": "0.37.1",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "lodash-es": "4.17.21",
    "typescript": "$typescript"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
