{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["nitropasskeys"],
  "ios": {
    "iosModuleName": "NitroPasskeys"
  },
  "android": {
    "androidNamespace": ["nitropasskeys"],
    "androidCxxLibName": "NitroPasskeys"
  },
  "autolinking": {
    "NitroPasskeys": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridNitroPasskeys"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridNitroPasskeys"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
